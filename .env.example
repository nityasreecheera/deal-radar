# Copy to .env and fill in. .env is gitignored.

# --- Required: what a company does ---
# Web search used to find out what a filing's company actually builds.
# Free tier at https://app.tavily.com
TAVILY_API_KEY=

# --- Required: judging fit ---
# The model that judges each company. Any OpenAI-compatible endpoint works —
# the code sends a bearer token and a chat completion, nothing provider-specific.
#
#   OpenAI       LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter   LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Use LLM_API_KEY rather than a provider-specific name, and keep only one key in
# this file. Two at once is the mistake that costs an afternoon: the leftover one
# goes to the new URL and fails as a 401 that reads like a bad key rather than
# the wrong key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# --- Optional: SEC identification ---
# The SEC requires a User-Agent naming a contact, and returns 403 without one.
# SEC_USER_AGENT=deal-radar you@example.com

# --- Optional: delivery by email ---
# Gmail needs an App Password, not your account password. Generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Port 25 is blocked outbound on Oracle Cloud; 587 works.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Both default to SMTP_USER, which is the usual case of mailing yourself.
# DIGEST_EMAIL_TO=
# DIGEST_EMAIL_FROM=
